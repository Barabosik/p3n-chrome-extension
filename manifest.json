{
  "manifest_version": 3,
  "name": "p3n: find the AI in any text",
  "short_name": "p3n",
  "version": "0.1.2",
  "description": "Select text, right-click, and see whether it reads as AI-written. Rewrite it so it doesn't, without leaving the page.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Check text for AI, or rewrite it",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "options_page": "ui/options.html",
  "permissions": ["contextMenus", "activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://api.p3n.si/*"]
}
